# /etc/tuition/tuition.env  (owner root, group tuition, mode 0640)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:/var/lib/tuition/tuition.db
# 32 random bytes: openssl rand -base64 32
# KEEP A COPY OUTSIDE THE SERVER (password manager): backups cannot be read without it.
APP_ENCRYPTION_KEY=
APP_BASE_URL=https://school.example
TRUST_PROXY=true
LOG_LEVEL=info
WEB_DIST=/opt/tuition/current/web
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://user:password@smtp.example:465
MAIL_FROM=מערכת גבייה <no-reply@school.example>
ALERT_EMAIL=office@school.example
PAYMENT_PROVIDER=mock
# נדרים פלוס: the address their server sends payment confirmations from (comma-separated).
NEDARIM_CALLBACK_IPS=18.194.219.73
SCHEDULER_ENABLED=true
ENABLE_TEST_ROUTES=false
LOGIN_RATE_LIMIT=10
