# /etc/tuition/backup.env  (owner root, group tuition, mode 0640)
APP_DIR=/opt/tuition/current
APP_ENV_FILE=/etc/tuition/tuition.env
BACKUP_DIR=/var/backups/tuition
# Public key(s) only. The private key stays with you, outside the server (decision D4).
AGE_RECIPIENTS_FILE=/etc/tuition/backup-recipients.txt
KEEP=30
# Oracle Object Storage. Leave OCI_BUCKET empty to keep backups on this machine only.
OCI_BUCKET=
OCI_PREFIX=tuition/
# instance_principal: the VM itself is allowed to write to the bucket (no key file on the server).
OCI_AUTH=instance_principal
HEALTH_URL=http://127.0.0.1:3000/health
