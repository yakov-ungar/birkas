# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# SQLite file (WAL mode). For PostgreSQL later: change provider in schema.prisma and this URL.
DATABASE_URL=file:../data/app.db

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts 2FA secrets and (later) provider credentials. Losing it makes 2FA unrecoverable.
APP_ENCRYPTION_KEY=

# Public URL used in invite links and emails.
APP_BASE_URL=http://localhost:5173

# true behind HTTPS (default true when NODE_ENV=production).
# COOKIE_SECURE=true
# true when running behind Nginx so client IPs are correct for rate limiting and logs.
TRUST_PROXY=false

LOG_LEVEL=info

# Serve the built web app from the API process (production).
# WEB_DIST=../web/dist

# outbox = store emails in the database only (default, nothing is sent).
# smtp   = also deliver via SMTP_URL. Do not enable before keys are approved.
MAIL_TRANSPORT=outbox
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=מערכת גבייה <no-reply@example.invalid>

# Payment provider. Only the mock exists until a real acquirer is chosen (stage 9).
PAYMENT_PROVIDER=mock
# Mock only: share (0..1) of valid charges that fail at random, for testing.
MOCK_FAILURE_RATE=0

# Nightly charges run inside the server at the time set in Settings. Set false to disable.
SCHEDULER_ENABLED=true
# Where to email alerts about failed nightly runs (default: active users with the settings permission).
# ALERT_EMAIL=office@school.example

# Test-only helper routes (mock mailbox, clock). Refused when NODE_ENV=production.
ENABLE_TEST_ROUTES=false
# Staff sign-in attempts per IP per 15 minutes.
LOGIN_RATE_LIMIT=10
