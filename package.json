{
  "name": "tuition-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tuition/server --filter @tuition/web dev",
    "build": "pnpm --filter @tuition/web build && pnpm --filter @tuition/server build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @tuition/web e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "effect@<3.20.0": "^3.20.0",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
