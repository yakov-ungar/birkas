{
  "name": "@tuition/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate",
    "create-admin": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "db:new-migration": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev --create-only"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@prisma/client": "6.19.0",
    "@tuition/shared": "workspace:*",
    "argon2": "0.44.0",
    "fastify": "5.6.2",
    "nodemailer": "7.0.10",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.4",
    "@types/qrcode": "1.5.6",
    "prisma": "6.19.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
