{
  "name": "@tuition/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate",
    "create-admin": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "db:new-migration": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev --create-only"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.6",
    "@prisma/client": "6.19.3",
    "@tuition/shared": "workspace:*",
    "argon2": "0.44.0",
    "bidi-js": "1.0.3",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "nodemailer": "10.1.1",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.6",
    "fast-check": "4.3.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "assets"
  ]
}
