// Portable schema: no database enums and no provider-specific types, so switching to
// PostgreSQL only requires changing `provider` below. Allowed values for string
// "enum" columns are enforced with Zod (packages/shared).
// Money columns (from stage 2 on) are Int in agorot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Key/value settings. `value` is JSON. Defaults live in packages/shared (DEFAULT_SETTINGS).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          String
  /// JSON array of permission keys.
  permissions   String
  active        Boolean   @default(true)
  /// AES-256-GCM encrypted TOTP secret.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// Last accepted TOTP time step, to block replay of the same code.
  totpLastStep  Int?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  invites       UserInvite[]
  recoveryCodes RecoveryCode[]
}

model UserInvite {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  /// pending_2fa | setup_2fa | full
  stage      String
  csrfToken  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Append-only (enforced by triggers in the init migration).
model LoginEvent {
  id        String   @id @default(cuid())
  at        DateTime
  userId    String?
  /// success | fail | locked | 2fa_ok | 2fa_fail | logout | timeout
  event     String
  ip        String?
  userAgent String?

  @@index([at])
}

/// Append-only audit trail with a hash chain (enforced by triggers in the init migration).
model AuditLog {
  id        String   @id @default(cuid())
  seq       Int      @unique
  at        DateTime
  /// user | parent | system
  actorType String
  actorId   String?
  actorName String
  action    String
  /// Human-readable Hebrew line shown in the audit screen (as in the demo log).
  summary   String
  entity    String
  entityId  String?
  /// JSON snapshots; never contain card data or secrets.
  before    String?
  after     String?
  ip        String?
  prevHash  String
  hash      String

  @@index([at])
  @@index([entity, entityId])
}

/// Outgoing email. In dev/test nothing is sent; messages stay here.
model Outbox {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  to              String
  subject         String
  text            String
  html            String?
  /// JSON array of attachment file names (contents are not stored).
  attachmentNames String?
  sentAt          DateTime?
  error           String?
}

// ======================= Stage 2: families, students, money =======================
// Money is Int agorot. Financial rows (Charge, Payment, PaymentAllocation, Receipt money
// columns, CardTransaction results) are append-only, enforced by triggers in 0002.

model Family {
  id         String    @id @default(cuid())
  /// "משפחת כהן"
  name       String
  parentName String
  phone      String
  /// Digits only (972 -> 0), for search and import matching.
  phoneNorm  String
  email      String    @default("")
  address    String    @default("")
  note       String    @default("")
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  students Student[]
  payments Payment[]

  @@index([phoneNorm])
}

model Student {
  id        String    @id @default(cuid())
  familyId  String
  fullName  String
  grade     String
  /// active | left | graduated
  status    String    @default("active")
  /// Enrollment order; decides who is "first" for the sibling discount (decision C2).
  enrollSeq Int
  createdAt DateTime  @default(now())
  /// Set only for a student deleted before any financial activity (decision B2).
  deletedAt DateTime?
  family    Family    @relation(fields: [familyId], references: [id])

  charges     Charge[]
  allocations PaymentAllocation[]
  cards       SavedCard[]
  checks      Check[]
  plans       BillingPlan[]
  tutoring    TutorAssignment[]

  @@index([familyId])
}

model ChargeCatalogItem {
  id            String   @id @default(cuid())
  name          String
  defaultAgorot Int
  type          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ChargeBatch {
  id            String   @id @default(cuid())
  description   String
  catalogItemId String?
  grade         String?
  count         Int
  amountAgorot  Int
  date          String
  createdById   String?
  createdAt     DateTime @default(now())
  charges       Charge[]
}

model Charge {
  id           String       @id @default(cuid())
  studentId    String
  yearName     String
  type         String
  description  String
  /// + debit (charge), - credit (discount). Reversal rows carry the opposite sign.
  amountAgorot Int
  /// Business date YYYY-MM-DD
  date         String
  reason       String?
  internalNote String?
  reversalOfId String?      @unique
  batchId      String?
  createdById  String?
  createdAt    DateTime     @default(now())
  student      Student      @relation(fields: [studentId], references: [id])
  batch        ChargeBatch? @relation(fields: [batchId], references: [id])
  reversalOf   Charge?      @relation("ChargeReversal", fields: [reversalOfId], references: [id])
  reversedBy   Charge?      @relation("ChargeReversal")

  @@index([studentId])
  @@index([date])
}

model Payment {
  id             String              @id @default(cuid())
  familyId       String
  /// card | transfer | cash | check | standing_order
  method         String
  /// + money in, - money out (refund or reversal)
  amountAgorot   Int
  date           String
  reference      String              @default("")
  /// payment | reversal | refund
  kind           String
  reversalOfId   String?             @unique
  cardTxnId      String?             @unique
  checkId        String?
  /// Cash only: the drawer session the money went into or out of (decision B9).
  cashSessionId  String?
  idempotencyKey String              @unique
  /// staff | portal | scheduler | bank | check
  source         String
  createdById    String?
  createdAt      DateTime            @default(now())
  family         Family              @relation(fields: [familyId], references: [id])
  allocations    PaymentAllocation[]
  receipt        Receipt?
  reversalOf     Payment?            @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy     Payment?            @relation("PaymentReversal")

  @@index([familyId])
  @@index([date])
}

model PaymentAllocation {
  id           String  @id @default(cuid())
  paymentId    String
  studentId    String
  amountAgorot Int
  payment      Payment @relation(fields: [paymentId], references: [id])
  student      Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([paymentId])
}

/// Gap-free numbering per document type (decision A3: separate sequences).
model DocumentSequence {
  docType String @id
  next    Int
}

model Receipt {
  id                 String    @id @default(cuid())
  /// receipt | credit_note | refund
  docType            String
  number             Int
  paymentId          String    @unique
  familyId           String
  /// Business date of the payment
  date               String
  issuedAt           DateTime
  payerName          String
  /// Absolute amount shown on the document
  amountAgorot       Int
  method             String
  reference          String    @default("")
  /// For a credit note: the receipt it credits.
  creditForReceiptId String?   @unique
  reason             String?
  /// What the payment paid, per student (JSON), frozen at issue time: e.g. tuition, a private lesson.
  itemsJson          String?
  /// SHA-256 of the canonical document content, frozen at issue time (decision A2).
  contentSha256      String
  // Operational fields (may change): print count and delivery.
  printCount         Int       @default(0)
  sentAt             DateTime?
  sentTo             String?
  payment            Payment   @relation(fields: [paymentId], references: [id])
  creditFor          Receipt?  @relation("ReceiptCredit", fields: [creditForReceiptId], references: [id])
  creditedBy         Receipt?  @relation("ReceiptCredit")

  @@unique([docType, number])
  @@index([familyId])
}

/// Card stored as a provider token only. Never a card number or CVV.
model SavedCard {
  id         String    @id @default(cuid())
  studentId  String
  provider   String
  tokenEnc   String
  last4      String
  brand      String
  expMonth   Int
  expYear    Int
  holderName String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  removedAt  DateTime?
  student    Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

/// Every call to the payment provider, written before the call so nothing is lost on a crash.
model CardTransaction {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  /// charge | refund
  kind           String
  familyId       String
  amountAgorot   Int
  cardId         String?
  last4          String
  /// pending | approved | declined | error
  status         String
  providerTxnId  String?
  approvalCode   String?
  errorMessageHe String?
  /// For refunds: the charge being refunded.
  refundOfId     String?
  /// For scheduled plan charges: which installment this attempt was for.
  planChargeId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Check {
  id              String    @id @default(cuid())
  studentId       String
  familyId        String
  number          String
  bank            String
  amountAgorot    Int
  dueDate         String
  /// pending | deposited | returned | cancelled
  status          String    @default("pending")
  paymentId       String?
  /// Set when the check bounced: the reversing payment and the fee charge.
  returnPaymentId String?
  feeChargeId     String?
  depositedAt     DateTime?
  returnedAt      DateTime?
  idempotencyKey  String?   @unique
  createdById     String?
  createdAt       DateTime  @default(now())
  student         Student   @relation(fields: [studentId], references: [id])

  @@index([status, dueDate])
}

// ======================= Stage 3: billing plans and the nightly run =======================

/// Bank account for a standing order (הוראת קבע). Account number encrypted.
model StandingOrder {
  id           String        @id @default(cuid())
  studentId    String
  bank         String
  branch       String
  accountEnc   String
  accountLast4 String
  /// active | cancelled
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  plans        BillingPlan[]
}

model BillingPlan {
  id              String         @id @default(cuid())
  studentId       String
  /// installments | recurring
  type            String
  /// installments: total amount; recurring: monthly amount
  amountAgorot    Int
  /// number of charges; 0 = recurring until further notice
  count           Int
  /// card | standing_order | transfer
  method          String
  cardId          String?
  standingOrderId String?
  startDate       String
  dayOfMonth      Int
  /// active | paused | cancelled | completed
  status          String         @default("active")
  /// Consent of the payer for recurring charges (decision A5).
  consentMethod   String?
  consentText     String?
  consentAt       DateTime?
  consentById     String?
  /// Same create form submitted twice returns the first plan.
  idempotencyKey  String?        @unique
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  student         Student        @relation(fields: [studentId], references: [id])
  standingOrder   StandingOrder? @relation(fields: [standingOrderId], references: [id])
  charges         PlanCharge[]

  @@index([studentId])
  @@index([status])
}

model PlanCharge {
  id           String      @id @default(cuid())
  planId       String
  seq          Int
  dueDate      String
  amountAgorot Int
  /// pending | processing | paid | failed | cancelled | expected (transfer / standing order awaiting the bank)
  status       String      @default("pending")
  attempts     Int         @default(0)
  lastError    String?
  paymentId    String?     @unique
  processingAt DateTime?
  updatedAt    DateTime    @updatedAt
  plan         BillingPlan @relation(fields: [planId], references: [id])

  @@unique([planId, seq])
  @@index([status, dueDate])
}

/// One row per scheduled job run; the unique key is the lock against a double run.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  runKey     String
  trigger    String
  startedAt  DateTime
  finishedAt DateTime?
  /// running | ok | failed
  status     String
  okCount    Int       @default(0)
  failCount  Int       @default(0)
  summary    String?

  @@unique([job, runKey])
}

// ======================= Stage 4: cash drawer, bank, Masav =======================

/// One shared cash drawer (decision B9). At most one open session (partial unique index in 0004).
model CashSession {
  id                 String    @id @default(cuid())
  openedAt           DateTime
  openedById         String
  openedByName       String
  openingFloatAgorot Int
  closedAt           DateTime?
  closedById         String?
  closedByName       String?
  expectedAgorot     Int?
  countedAgorot      Int?
  diffAgorot         Int?
  notes              String?
}

model BankImport {
  id           String            @id @default(cuid())
  fileName     String
  fileHash     String            @unique
  importedAt   DateTime
  importedById String
  rows         Int
  matched      Int
  transactions BankTransaction[]
}

model BankTransaction {
  id                    String     @id @default(cuid())
  importId              String
  date                  String
  description           String
  reference             String     @default("")
  amountAgorot          Int
  rowHash               String     @unique
  suggestedFamilyId     String?
  suggestedPlanChargeId String?
  /// high | medium | none
  matchLevel            String     @default("none")
  matchReason           String?
  /// pending | registered | ignored
  status                String     @default("pending")
  paymentId             String?
  familyId              String?
  decidedById           String?
  decidedAt             DateTime?
  bankImport            BankImport @relation(fields: [importId], references: [id])

  @@index([status])
}

model MasavExport {
  id          String            @id @default(cuid())
  createdAt   DateTime
  createdById String
  chargeDate  String
  count       Int
  totalAgorot Int
  fileName    String
  sha256      String
  /// submitted | settled
  status      String            @default("submitted")
  settledAt   DateTime?
  items       MasavExportItem[]
}

model MasavExportItem {
  id           String      @id @default(cuid())
  exportId     String
  planChargeId String
  amountAgorot Int
  /// submitted | paid | returned
  status       String      @default("submitted")
  returnReason String?
  paymentId    String?
  export       MasavExport @relation(fields: [exportId], references: [id])

  @@index([planChargeId])
}

// ======================= Stage 5: collection and messages =======================

/// Contact log with parents: notes and payment promises (demo "מעקב גבייה").
model ContactNote {
  id            String    @id @default(cuid())
  familyId      String
  at            DateTime
  date          String
  byId          String
  byName        String
  /// call | message | meeting | promise
  type          String
  note          String
  promiseDate   String?
  promiseAgorot Int?
  fulfilledAt   DateTime?
  fulfilledById String?

  @@index([familyId])
}

/// The demo's four reminder rules (editable, not extendable; decision C13).
model ReminderRule {
  key       String   @id
  name      String
  enabled   Boolean
  /// sms | whatsapp | email
  channel   String
  template  String
  updatedAt DateTime @updatedAt
}

model MessageBatch {
  id             String    @id @default(cuid())
  at             DateTime
  channel        String
  /// manual | auto
  source         String
  ruleKey        String?
  recipientCount Int
  template       String
  createdByName  String?
  messages       Message[]
}

/// Outgoing SMS / WhatsApp / email. Automatic SMS and WhatsApp wait for allowed hours (decision C14).
model Message {
  id          String        @id @default(cuid())
  batchId     String?
  familyId    String?
  channel     String
  to          String
  body        String
  /// queued | sent | failed
  status      String        @default("queued")
  notBefore   DateTime
  sentAt      DateTime?
  providerRef String?
  error       String?
  /// Prevents sending the same automatic message twice.
  dedupeKey   String?       @unique
  ruleKey     String?
  createdAt   DateTime      @default(now())
  batch       MessageBatch? @relation(fields: [batchId], references: [id])

  @@index([status, notBefore])
  @@index([familyId, ruleKey])
}

// ---------- stage 6: parent portal (decision C15) ----------

/// One-time sign-in code sent by SMS or email. Only an HMAC of the code is stored.
model ParentOtp {
  id        String    @id @default(cuid())
  familyId  String
  /// sms | email
  channel   String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  ip        String?
  createdAt DateTime

  @@index([familyId, createdAt])
}

/// A signed-in parent. The family comes only from here, never from the request.
model ParentSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familyId   String
  csrfToken  String
  createdAt  DateTime
  lastSeenAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([familyId])
}

/// "Remember this device" for 30 days: lets the parent back in after an idle timeout without a new code.
model ParentDevice {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familyId   String
  createdAt  DateTime
  lastUsedAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([familyId])
}

/// Requests parents send from the portal: installments, discount, contact details update.
model ParentRequest {
  id            String    @id @default(cuid())
  familyId      String
  /// installments | discount | contact
  type          String
  /// JSON, shape per type (packages/shared stage6.ts).
  details       String
  note          String    @default("")
  /// pending | approved | rejected
  status        String    @default("pending")
  createdAt     DateTime
  decidedAt     DateTime?
  decidedById   String?
  decidedByName String?
  rejectReason  String?
  /// Short Hebrew summary of what the approval created.
  resultSummary String?

  @@index([status])
  @@index([familyId, createdAt])
}

// ---------- stage 7 ----------

/// Connection settings for the six external services (demo "חיבורים"). Credentials are AES-256-GCM
/// encrypted in `configEnc` and never returned to the browser.
model Integration {
  key           String    @id
  connected     Boolean   @default(false)
  /// test | live. Live stays closed until a real provider is chosen (plan stage 9).
  mode          String    @default("test")
  configEnc     String?
  /// Non-secret summary shown in the list.
  details       String    @default("")
  updatedAt     DateTime?
  updatedByName String?
}

// ---------- private lessons with אברכים ----------

model Tutor {
  id          String            @id @default(cuid())
  name        String
  phone       String            @default("")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  assignments TutorAssignment[]
}

/// A student's private lesson: tutor, subject (from settings) and a monthly price,
/// charged at the end of every month from startDate until endDate.
model TutorAssignment {
  id          String        @id @default(cuid())
  studentId   String
  tutorId     String
  subject     String
  priceAgorot Int
  startDate   String
  endDate     String?
  note        String        @default("")
  createdById String?
  createdAt   DateTime      @default(now())
  student     Student       @relation(fields: [studentId], references: [id])
  tutor       Tutor         @relation(fields: [tutorId], references: [id])
  charges     TutorCharge[]

  @@index([studentId])
  @@index([tutorId])
}

/// One charge per assignment per month: the unique pair makes the month-end run idempotent.
model TutorCharge {
  id           String          @id @default(cuid())
  assignmentId String
  month        String
  chargeId     String          @unique
  createdAt    DateTime        @default(now())
  assignment   TutorAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, month])
}
